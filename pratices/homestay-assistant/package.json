{
  "name": "homestay-assistant",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "web": "turbo run dev --filter=web",
    "api": "turbo run dev --filter=api",
    "agent": "turbo run dev --filter=agent"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.25.76"
  }
}
