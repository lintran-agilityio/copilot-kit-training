generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Amenity {
  monitor
  coffee
  mic
  wifi
  video
  whiteboard
  phone
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Room {
  id             String    @id
  name           String
  level          Int
  levelColor     String    @map("level_color")
  capacity       Int
  description    String
  imageUrl       String    @map("image_url")
  availableSlots Int       @map("available_slots")
  pricePerNight  Int       @default(0) @map("price_per_night")
  amenities      Amenity[]
  bookings       Booking[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("rooms")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  bookings  Booking[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Booking {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId       String        @map("room_id")
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkInDate  DateTime      @map("check_in_date") @db.Date
  checkOutDate DateTime      @map("check_out_date") @db.Date
  guests       Int
  totalPrice   Int           @map("total_price")
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([roomId, checkInDate, checkOutDate])
  @@map("bookings")
}
